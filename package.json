{
  "name": "princeton-i-m-s-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=\"--import ./instrument.server.mjs\" vite dev",
    "generate-routes": "tsr generate",
    "build": "pnpm run check && pnpm run lingui:compile && vite build && pnpm run typecheck && node -e \"const fs=require('node:fs');if(fs.existsSync('.output/server'))fs.copyFileSync('instrument.server.mjs','.output/server/instrument.server.mjs')\"",
    "start": "node --env-file-if-exists=.env --import ./.output/server/instrument.server.mjs .output/server/index.mjs",
    "test": "vitest run",
    "check": "pnpm run lint && pnpm run fmt:check",
    "check:all": "pnpm run check && pnpm run typecheck",
    "ci:check": "pnpm run lint",
    "ci:format": "pnpm run fmt:check",
    "fmt": "oxfmt README.md package.json src assignments .vscode components.json instrument.server.mjs lingui.config.ts vite.config.ts tsconfig.json tsr.config.json",
    "fmt:check": "oxfmt --check README.md package.json src assignments .vscode components.json instrument.server.mjs lingui.config.ts vite.config.ts tsconfig.json tsr.config.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "lingui:extract": "lingui extract --clean",
    "lingui:compile": "lingui compile"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@faker-js/faker": "^10.5.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@lingui/core": "^6.5.0",
    "@lingui/react": "^6.5.0",
    "@sentry/tanstackstart-react": "^10.66.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/match-sorter-utils": "latest",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "latest",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-hotkeys-devtools": "^0.7.0",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/react-table": "latest",
    "@tanstack/router-plugin": "^1.168.22",
    "@tanstack/zod-form-adapter": "^0.42.1",
    "@unpic/react": "^1.0.2",
    "class-variance-authority": "^0.7.1",
    "cnfast": "^0.0.8",
    "cookie-es": "^3.1.1",
    "date-fns": "^4.4.0",
    "dotenv-cli": "^11.0.0",
    "lucide-react": "^1.25.0",
    "next-themes": "^0.4.6",
    "nitro": "npm:nitro-nightly@3.0.1-20260717-080150-bfc2f5ef",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shadcn": "^4.13.1",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@lingui/babel-plugin-lingui-macro": "^6.5.0",
    "@lingui/cli": "^6.5.0",
    "@lingui/conf": "^6.5.0",
    "@lingui/vite-plugin": "^6.5.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@tanstack/eslint-plugin-query": "^5.101.4",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/router-cli": "^1.167.21",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "oxlint-tsgolint": "^0.25.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "24.x",
    "pnpm": ">=10.0.0 <12.0.0"
  }
